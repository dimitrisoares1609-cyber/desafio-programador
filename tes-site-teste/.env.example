# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só para os testes locais (Supabase local via `npm run db:start`).
# Nunca use a chave service_role do projeto na nuvem aqui, nem na Vercel.
SUPABASE_TEST_SERVICE_ROLE_KEY=
