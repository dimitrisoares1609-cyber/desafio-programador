MONGO_URL=mongodb://localhost:27017
DB_NAME=barbera
# Gere um valor longo e aleatório: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo
# Endereço do frontend: usado no CORS e nos retornos do checkout.
FRONTEND_URL=http://localhost:5173
# true quando servir por HTTPS.
COOKIE_SECURE=false
# Conta da equipe criada na primeira subida (troque a senha fora do ambiente local).
ADMIN_EMAIL=admin@barbera.local
ADMIN_PASSWORD=Barbera123!
# Sem STRIPE_API_KEY o checkout roda em modo demonstrativo (nada é cobrado).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
